# Supabase project credentials (Project settings > API).
# Copy this file to `.env.local` and fill both values in.
#
# Without them the public site still renders -- it falls back to the content in
# `src/lib/data.ts` -- but the CMS at /admin is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
